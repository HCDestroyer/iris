# Iris · variables de entorno de desarrollo.
#
#   cp .env.example .env        # .env no se commitea
#
# Valores de ejemplo para el compose local (infra/docker-compose.yml). Nunca pongas aquí secretos
# reales: en lab y producción van en el gestor de secretos del entorno (o en un .env fuera de git).
# Las URLs apuntan a localhost (procesos corriendo en tu máquina, `make dev`). En el perfil `app`
# del compose, api, worker y migrar cargan este archivo y luego .env (env_file), y el compose
# reemplaza solo lo que cambia dentro de su red: IRIS_DB_URL, IRIS_S3_ENDPOINT, IRIS_REDIS_URL,
# IRIS_OSRM_URL, IRIS_SMTP_*, IRIS_CORREO_CA, PORT/IRIS_PUERTO e IRIS_ADJUNTOS_ALMACEN=s3.
# Lista completa de lo que leen cmd/iris y cmd/worker: apps/api/.env.example.

# --- API (apps/api) -------------------------------------------------------------------------
# Puerto HTTP de la API (también IRIS_PUERTO, que manda si está). En pruebas, cada agente usa el
# suyo (35<n>).
PORT=8080
# debug | info | warn | error (logs JSON).
IRIS_LOG_NIVEL=info
# Secure en las cookies de sesión. true también sirve en http://localhost (el navegador lo trata
# como seguro); false solo en dev o lab por HTTP con otro host (p. ej. http://iris-lab:3000).
IRIS_COOKIE_SEGURA=true
# Vida absoluta de una sesión del panel.
IRIS_DURACION_SESION=12h
# Origen público con el que el navegador llega al panel (enlaces en correos, autologin, CORS,
# URL de los webhooks de Argos y Horus, enlaces de conexión y entrada al portal de soporte).
IRIS_BASE_URL=http://localhost:3000
# Base de datos. En pruebas: una base propia, p. ej. .../iris_test_i1 (CLAUDE.md §12).
IRIS_DB_URL=postgres://iris:iris@localhost:5432/iris?sslmode=disable
# Redes (CIDR o IP, separadas por coma) de los proxies cuyo X-Forwarded-For se cree (p. ej. la del
# panel). Vacía = no se confía en ninguno: la IP del cliente es la de la conexión.
IRIS_PROXIES_CONFIABLES=
# 32 bytes en base64 (openssl rand -base64 32) para cifrar el TOTP, los secretos de los conectores
# (token atk_ de Argos, hf_pat_ de Horus, secreto del webhook) y las contraseñas de los buzones.
# La leen la API y el worker. Vacía = sin MFA, conectores ni buzones. Nunca la commitees; cambiarla
# tiene consecuencias (docs/runbooks/rotar-clave-cifrado.md).
IRIS_CLAVE_CIFRADO=
# Relay del outbox: cada cuánto corre aunque no llegue un NOTIFY.
IRIS_RELAY_INTERVALO=5s
# Tras cuánto una Idempotency-Key que quedó «en proceso» (el proceso cayó) se puede retomar.
IRIS_IDEMPOTENCIA_RECLAMO=2m
# Conector Argos: timeout por llamada, ventana de X-Webhook-Timestamp y http:// solo en desarrollo.
IRIS_ARGOS_TIMEOUT=5s
IRIS_WEBHOOK_VENTANA=5m
IRIS_CONECTORES_PERMITIR_HTTP=false
# Redes internas a las que el conector Argos sí puede llamar (solo dev y lab; vacía en producción).
IRIS_ARGOS_REDES_PERMITIDAS=
# Conector Horus: timeout por llamada y redes internas permitidas (solo dev y lab).
IRIS_HORUS_TIMEOUT=5s
IRIS_HORUS_REDES_PERMITIDAS=
# Vida de una sesión del portal de soporte (/soporte).
IRIS_DURACION_SESION_PORTAL=2h
# Correo de soporte (buzones IMAP/SMTP; las contraseñas se cifran con IRIS_CLAVE_CIFRADO). Redes
# internas a las que sí se puede conectar (solo dev y lab; vacía en producción: protección SSRF),
# CA extra en PEM para verificar TLS (el certificado siempre se verifica; nunca en claro), tamaño
# máximo de un correo en bytes (más grande: solo cabeceras) y tiempo máximo por conexión.
# Con la API en tu máquina y Mailpit del compose: IRIS_CORREO_REDES_PERMITIDAS=127.0.0.1/32 e
# IRIS_CORREO_CA=<ruta absoluta>/infra/mailpit/certs/ca.pem. En el perfil app, el compose ya
# monta la CA y permite su propia red (IRIS_RED_COMPOSE) si esta queda vacía.
IRIS_CORREO_REDES_PERMITIDAS=
IRIS_CORREO_CA=
IRIS_CORREO_TAMANO_MAX=10485760
IRIS_CORREO_TIMEOUT=30s
# Topes anti spam del portal del cliente (/soporte), contados en la base por cliente y empresa:
# tickets del portal abiertos, tickets creados por hora y mensajes por minuto (429 al pasarse).
IRIS_PORTAL_TICKETS_ABIERTOS=10
IRIS_PORTAL_TICKETS_POR_HORA=20
IRIS_PORTAL_MENSAJES_POR_MINUTO=10
# Ubicación en vivo de la app de campo (POST /api/v1/campo/posiciones; api y worker): puntos por
# lote, lotes por minuto por técnico (429 al pasarse), intervalo mínimo entre puntos guardados y
# retención en días (el worker borra las particiones mensuales más viejas).
IRIS_POSICIONES_MAX_POR_LOTE=500
IRIS_POSICIONES_LOTES_POR_MINUTO=6
IRIS_POSICIONES_INTERVALO_MIN=5s
IRIS_POSICIONES_RETENCION_DIAS=90
# Solo caché, con invalidación por evento (nunca TTL como consistencia). Reservada: la API todavía
# no usa Redis.
IRIS_REDIS_URL=redis://localhost:6379/0

# Adjuntos (fotos, firmas, documentos): S3 compatible; MinIO en dev.
IRIS_S3_ENDPOINT=http://localhost:9000
IRIS_S3_REGION=us-east-1
IRIS_S3_BUCKET=iris-adjuntos
IRIS_S3_ACCESS_KEY=iris
# Solo para el MinIO local (mínimo 8 caracteres). Cámbialo en cualquier entorno compartido.
IRIS_S3_SECRET_KEY=iris-dev-solo-local
# MinIO necesita rutas estilo path (http://host/bucket/objeto).
IRIS_S3_PATH_STYLE=true
# Dónde quedan los adjuntos completos: s3 (por defecto si hay IRIS_S3_ENDPOINT) o local
# (IRIS_ADJUNTOS_DIR). Tamaño máximo por adjunto en bytes y tipos MIME permitidos (coma; vacía =
# image/jpeg, image/png, image/webp, image/svg+xml, application/pdf; text/html nunca).
IRIS_ADJUNTOS_ALMACEN=s3
IRIS_ADJUNTOS_DIR=./datos/adjuntos
IRIS_ADJUNTOS_TAMANO_MAX=26214400
IRIS_ADJUNTOS_MIME=
# Cuotas de subidas sin terminar (429 demasiadas_subidas): por usuario (cantidad y bytes
# declarados) y por orden/ticket. Sin actividad por más de IRIS_ADJUNTOS_ABANDONO, la subida se
# rechaza («abandonado») y se borran sus partes (job del worker, cada hora).
IRIS_ADJUNTOS_MAX_EN_CURSO_USUARIO=50
IRIS_ADJUNTOS_MAX_BYTES_USUARIO=524288000
IRIS_ADJUNTOS_MAX_EN_CURSO_ENTIDAD=30
IRIS_ADJUNTOS_ABANDONO=48h

# Rutas (OSRM con el extracto de Guatemala; infra/osrm/preparar.sh). Reservada para la Fase 3
# (agenda y rutas): la API todavía no la lee.
IRIS_OSRM_URL=http://localhost:5000

# Correo saliente del sistema (avisos). Reservadas: hoy la API solo manda correo por los buzones de
# soporte, cada uno con su propio SMTP guardado en la base. En dev, Mailpit (UI en
# http://localhost:8025) exige STARTTLS en :1025 con la CA de infra/mailpit/certs/ca.pem.
IRIS_SMTP_HOST=localhost
IRIS_SMTP_PORT=1025
IRIS_SMTP_USUARIO=
IRIS_SMTP_CONTRASENA=
IRIS_SMTP_TLS=starttls
IRIS_SMTP_REMITENTE=Iris <no-responder@iris.example>

# --- Panel web (apps/web) -------------------------------------------------------------------
# URL con que el servidor de Next alcanza la API: el panel sirve /api/* como proxy hacia aquí,
# así las cookies de sesión son del mismo origen. Se lee al arrancar cada petición, no en el build.
IRIS_API_URL=http://localhost:8080

# --- Compose (infra/docker-compose.yml) ------------------------------------------------------
# Credenciales del Postgres del compose (solo dev). Deben coincidir con IRIS_DB_URL.
IRIS_PG_USUARIO=iris
IRIS_PG_CONTRASENA=iris
IRIS_PG_BASE=iris
# Puertos publicados en 127.0.0.1. Cámbialos si ya tienes Postgres o Redis en la máquina
# (y ajusta IRIS_DB_URL / IRIS_REDIS_URL).
IRIS_PG_PUERTO=5432
IRIS_REDIS_PUERTO=6379
IRIS_MINIO_PUERTO=9000
IRIS_MINIO_CONSOLA_PUERTO=9001
IRIS_MAILPIT_SMTP_PUERTO=1025
IRIS_MAILPIT_UI_PUERTO=8025
IRIS_OSRM_PUERTO=5000
IRIS_API_PUERTO=8080
IRIS_WEB_PUERTO=3000
# Extracto de OpenStreetMap que prepara infra/osrm/preparar.sh.
IRIS_OSRM_PBF_URL=https://download.geofabrik.de/central-america/guatemala-latest.osm.pbf
# Etiqueta de las imágenes api/worker/web construidas localmente (perfil app).
IRIS_IMAGEN_TAG=dev
# Imágenes de MinIO (por defecto el fork comunitario pgsty/*; minio/minio ya no está en Docker Hub).
IRIS_MINIO_IMAGEN=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
IRIS_MC_IMAGEN=pgsty/mc:RELEASE.2026-09-16T00-00-00Z
# Subred de la red del compose. Si IRIS_CORREO_REDES_PERMITIDAS queda vacía, el compose la usa para
# que la API y el worker puedan hablar con Mailpit. Cámbiala si choca con otra red de tu máquina.
IRIS_RED_COMPOSE=172.28.10.0/24
# Solo si construyes detrás de un proxy que intercepta TLS: su CA en PEM, dentro del repo y relativa
# a infra/ (p. ej. ./imagenes/ca-extra.pem; infra/imagenes/README.md). Se usa al bajar módulos de Go y
# paquetes de npm; no queda en las imágenes. Vacía = sin CA extra.
IRIS_BUILD_CA_EXTRA=

# --- Respaldos (infra/respaldo/; docs/runbooks/respaldos.md) ---------------------------------
# Cifrado con age hacia claves públicas: el servidor que respalda solo tiene la pública
# (age-keygen -y) y no puede leer los respaldos. La privada (AGE-SECRET-KEY-…) se guarda fuera del
# servidor y se usa solo al restaurar; sin ella los respaldos no sirven.
IRIS_RESPALDO_DESTINATARIOS=
IRIS_RESPALDO_IDENTIDAD=
# Carpeta donde quedan los respaldos (*.dump.age) y cuántos días se conservan.
IRIS_RESPALDO_DIR=./infra/respaldo/salida
IRIS_RESPALDO_DIAS=14
