root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# YAML de compose y de GitHub Actions: 2 espacios, como en ArgosISP
[*.{yml,yaml}]
indent_size = 2

# gofmt y make exigen tabuladores
[{*.go,go.mod,go.work,Makefile,*.mk}]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
