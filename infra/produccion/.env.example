# Iris · production settings (template). install.sh copies this file to <install dir>/.env
# (mode 600), fills in the secrets and the answers, and never overwrites a value that is already
# set. Never commit a filled-in copy. After editing the .env: `irisctl start`.
# Full guide: docs/runbooks/install.md. Every variable the API reads: apps/api/.env.example.

# --- Managed by install.sh (do not edit by hand) ---------------------------------------------
# Install folder (holds this .env, current/, releases/, backups/ and certs/).
IRIS_DIR=/opt/iris
# Installed version (changed by `irisctl upgrade`) and image registry.
IRIS_VERSION=
IRIS_REGISTRY=ghcr.io/hcdestroyer

# --- Public address -------------------------------------------------------------------------
# Public origin users type in the browser (the reverse proxy's HTTPS address, no trailing slash).
# Used for links in mail, autologin, Argos/Horus webhooks, connection links and the support portal.
IRIS_BASE_URL=
# Secure cookies (keep true behind HTTPS).
IRIS_COOKIE_SEGURA=true
IRIS_LOG_NIVEL=info

# --- Argos and Horus ------------------------------------------------------------------------
# Origins (https://host[:port], comma separated) whose connection links Iris accepts. Required to
# connect: when connecting, Iris hands a token to the link's origin and only to these.
IRIS_ARGOS_ORIGENES=
IRIS_HORUS_ORIGENES=
# Internal networks (CIDR, comma separated) Iris may call for Argos/Horus. Empty when they live on a
# public IP. If Argos runs on this same server and is reached through a private address, put that
# network here (e.g. 172.16.0.0/12 for Docker networks).
IRIS_ARGOS_REDES_PERMITIDAS=
IRIS_HORUS_REDES_PERMITIDAS=
# Allow http:// connectors (only when Argos/Horus have no HTTPS).
IRIS_CONECTORES_PERMITIR_HTTP=false

# --- Secrets (generated by install.sh; back them up OUTSIDE this server) ----------------------
# Encrypts MFA secrets, connector tokens and mailbox passwords. Losing it makes them unreadable.
# Never change it by hand: docs/runbooks/rotar-clave-cifrado.md.
IRIS_CLAVE_CIFRADO=
IRIS_CLAVE_CIFRADO_ANTERIOR=
# PostgreSQL (the database volume is created with these; do not change them after the first start).
IRIS_PG_USUARIO=iris
IRIS_PG_CONTRASENA=
IRIS_PG_BASE=iris
# MinIO (attachments). The secret must be at least 8 characters.
IRIS_S3_ACCESS_KEY=iris
IRIS_S3_SECRET_KEY=
IRIS_S3_BUCKET=iris-adjuntos
IRIS_S3_REGION=us-east-1

# --- Ports (always bound to 127.0.0.1) ------------------------------------------------------
# The reverse proxy points to the panel port. The others are for local checks and admin tools.
IRIS_WEB_PUERTO=3000
IRIS_API_PUERTO=8080
IRIS_PG_PUERTO=5432
IRIS_MINIO_PUERTO=9000
IRIS_MINIO_CONSOLA_PUERTO=9001
IRIS_OSRM_PUERTO=5000

# --- Docker network and client IP ------------------------------------------------------------
# Subnet of the compose network and fixed IP of the panel inside it (not the .1 gateway). Change
# the subnet only if it collides with another network on this server.
IRIS_RED_COMPOSE=172.28.10.0/24
IRIS_WEB_IP=172.28.10.10
# Proxies whose X-Forwarded-For the API trusts. Empty = only the panel's fixed IP. Never the whole
# Docker network nor its gateway.
IRIS_PROXIES_CONFIABLES=
# Proxies in front of the panel whose X-Forwarded-Proto the panel trusts. Empty = the protocol of
# the connection to the panel.
IRIS_WEB_PROXIES_CONFIABLES=

# --- Mail (support mailboxes) ----------------------------------------------------------------
# Production uses a real SMTP/IMAP server. Each mailbox (panel → Support → Mailboxes) stores its
# own host, port, user and password (encrypted with IRIS_CLAVE_CIFRADO); TLS is always verified.
# Internal networks Iris may connect to for mail (empty when the mail server has a public IP).
IRIS_CORREO_REDES_PERMITIDAS=
# Optional: CA in PEM for a mail server with a private certificate. Copy it to <install dir>/certs/
# and set e.g. IRIS_CORREO_CA=/run/iris/certs/mail-ca.pem. Empty = the system's public CAs.
IRIS_CORREO_CA=
IRIS_CORREO_TIMEOUT=30s
# System mail (reserved: today Iris only sends mail through the mailboxes).
IRIS_SMTP_HOST=
IRIS_SMTP_PORT=587
IRIS_SMTP_USUARIO=
IRIS_SMTP_CONTRASENA=
IRIS_SMTP_TLS=starttls
IRIS_SMTP_REMITENTE=

# --- Street routing (optional) ---------------------------------------------------------------
# true = start the osrm service (needs data: infra/osrm/preparar.sh). install.sh --with-osrm sets
# both lines. Without OSRM, daily routes are proposed in straight lines (marked as degraded).
IRIS_OSRM=false
IRIS_OSRM_URL=

# --- Backups (infra/respaldo; `irisctl backup`, and always before `irisctl upgrade`) ----------
# age public key(s) file. install.sh creates a key pair in <install dir>/backup-keys/ if empty.
# The PRIVATE key (identity) is only needed to restore: copy it off this server.
IRIS_RESPALDO_DESTINATARIOS=
IRIS_RESPALDO_IDENTIDAD=
IRIS_RESPALDO_DIR=/opt/iris/backups
IRIS_RESPALDO_DIAS=14

# --- Images of the data services (change only to use your own mirror) -----------------------
IRIS_MINIO_IMAGEN=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
IRIS_MC_IMAGEN=pgsty/mc:RELEASE.2026-09-16T00-00-00Z
