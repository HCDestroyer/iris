# Variables de entorno de apps/api (cmd/iris y cmd/worker). Copia a .env y ajusta; .env no se commitea.

# Postgres (obligatoria). En desarrollo, el Postgres de docker-compose.
IRIS_DB_URL=postgres://iris:iris@localhost:5432/iris_dev?sslmode=disable

# Puerto HTTP (también se acepta PORT). Pruebas por agente: 35<n>.
IRIS_PUERTO=3500

# debug | info | warn | error (logs JSON con slog)
IRIS_LOG_NIVEL=info

# Secure en las cookies iris_sesion e iris_csrf. false solo en desarrollo sin HTTPS.
IRIS_COOKIE_SEGURA=true

# Vida absoluta de una sesión del panel.
IRIS_DURACION_SESION=12h
# Vida absoluta de una sesión del portal de soporte (/soporte, actor cliente).
IRIS_DURACION_SESION_PORTAL=2h

# 32 bytes en base64 para cifrar secretos en reposo (TOTP, tokens atk_ y hf_pat_ y secreto del
# webhook de los conectores). Generar: openssl rand -base64 32
# Vacía = el MFA y los conectores quedan deshabilitados. Nunca la commitees. Cambiarla deja
# ilegibles los secretos guardados (hay que volver a conectar Argos).
IRIS_CLAVE_CIFRADO=

# Origen público de Iris (el del panel, que hace de proxy de /api). Con él se arman la URL del
# webhook que se entrega a Argos y Horus (<base>/api/v1/integraciones/<sistema>/webhook/<id>), los
# enlaces de conexión (<base>/conectar#<código>) y la entrada al portal de soporte
# (<base>/soporte/entrar#<ticket>). Vacía = no se pueden conectar Argos ni Horus.
IRIS_BASE_URL=http://localhost:3000

# Redes (CIDR o IP, separadas por coma) de los proxies cuyo X-Forwarded-For se cree, p. ej. la del
# panel (Next.js). Vacía = no se confía en ninguno y la IP del cliente es la de la conexión.
IRIS_PROXIES_CONFIABLES=

# Conector Argos: tiempo máximo de cada llamada (las lecturas se reintentan 3 veces con espera).
IRIS_ARGOS_TIMEOUT=5s
# Desfase máximo aceptado en X-Webhook-Timestamp de los webhooks entrantes.
IRIS_WEBHOOK_VENTANA=5m
# Acepta conectores con URL http:// (solo desarrollo; el token viaja en Authorization).
IRIS_CONECTORES_PERMITIR_HTTP=false
# Redes internas (CIDR o IP, separadas por coma) a las que el conector sí puede llamar. Vacía =
# Argos debe estar en una IP pública: loopback, privadas, 169.254.0.0/16, CGNAT y demás
# reservadas se bloquean al conectar, también tras resolver el DNS (SSRF). Solo dev y lab.
IRIS_ARGOS_REDES_PERMITIDAS=
# Conector Horus: tiempo máximo de cada llamada y redes internas permitidas (como las de Argos;
# solo dev y lab, vacía en producción).
IRIS_HORUS_TIMEOUT=5s
IRIS_HORUS_REDES_PERMITIDAS=

# Correo de soporte (buzones IMAP/SMTP; las contraseñas se cifran con IRIS_CLAVE_CIFRADO). Redes
# internas a las que sí se puede conectar (solo dev y lab; vacía en producción: protección SSRF),
# CA extra en PEM para verificar TLS (el certificado siempre se verifica; nunca en claro), tamaño
# máximo de un correo en bytes (más grande: solo cabeceras) y tiempo máximo por conexión.
IRIS_CORREO_REDES_PERMITIDAS=
IRIS_CORREO_CA=
IRIS_CORREO_TAMANO_MAX=10485760
IRIS_CORREO_TIMEOUT=30s
# Topes anti spam del portal del cliente (/soporte), contados en la base por cliente y empresa:
# tickets del portal abiertos, tickets creados por hora y mensajes por minuto (429 al pasarse).
IRIS_PORTAL_TICKETS_ABIERTOS=10
IRIS_PORTAL_TICKETS_POR_HORA=20
IRIS_PORTAL_MENSAJES_POR_MINUTO=10

# Adjuntos (fotos, firmas, documentos; subida reanudable tus en /api/v1/adjuntos). Almacenamiento:
# s3 (por defecto si hay IRIS_S3_ENDPOINT) o local (directorio IRIS_ADJUNTOS_DIR, para dev y
# pruebas). Tamaño máximo por adjunto (bytes) y tipos MIME permitidos separados por coma (vacía =
# image/jpeg, image/png, image/webp, image/svg+xml, application/pdf; text/html no se acepta nunca).
IRIS_ADJUNTOS_ALMACEN=local
IRIS_ADJUNTOS_DIR=./datos/adjuntos
IRIS_ADJUNTOS_TAMANO_MAX=26214400
IRIS_ADJUNTOS_MIME=
# S3 compatible (MinIO en dev: docker-compose crea el bucket). Firma AWS Signature V4.
IRIS_S3_ENDPOINT=
IRIS_S3_REGION=us-east-1
IRIS_S3_BUCKET=iris-adjuntos
IRIS_S3_ACCESS_KEY=
IRIS_S3_SECRET_KEY=
IRIS_S3_PATH_STYLE=true

# Cada cuánto corre el relay del outbox aunque no llegue un NOTIFY.
IRIS_RELAY_INTERVALO=5s

# Tras cuánto una Idempotency-Key que quedó «en proceso» (el proceso cayó a mitad) se puede
# retomar con la misma petición. Mayor que el WriteTimeout del servidor (60 s).
IRIS_IDEMPOTENCIA_RECLAMO=2m

# Solo pruebas: base de pruebas (se BORRA y recrea; debe empezar con iris_test).
# Por defecto postgres://argosisp:argosisp@localhost:5432/iris_test_i1. IRIS_DB cambia solo el nombre.
# IRIS_DB=iris_test_i1
