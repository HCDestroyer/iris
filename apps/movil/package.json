{
    "name": "@iris/movil",
    "version": "0.0.0",
    "private": true,
    "description": "App de campo nativa de Iris (Expo): mismo motor sin conexión que la PWA, cámara, escáner y GPS en segundo plano",
    "main": "index.ts",
    "scripts": {
        "start": "expo start",
        "android": "expo run:android",
        "ios": "expo run:ios",
        "exportar": "expo export --platform android --output-dir dist",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "jest"
    },
    "dependencies": {
        "@hookform/resolvers": "5.9.2",
        "@iris/contratos": "workspace:*",
        "@iris/sync": "workspace:*",
        "@iris/ui": "workspace:*",
        "expo": "58.0.21",
        "expo-camera": "58.0.14",
        "expo-crypto": "58.0.7",
        "expo-file-system": "58.0.13",
        "expo-image-manipulator": "58.0.16",
        "expo-image-picker": "58.0.10",
        "expo-location": "58.0.20",
        "expo-network": "58.0.4",
        "expo-secure-store": "58.0.2",
        "expo-sqlite": "58.0.14",
        "expo-status-bar": "58.0.4",
        "expo-task-manager": "58.0.12",
        "lucide-react-native": "1.64.0",
        "react": "19.3.0",
        "react-hook-form": "7.91.0",
        "react-native": "0.88.1",
