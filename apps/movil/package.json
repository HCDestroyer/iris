        "@react-native/jest-preset": "0.88.1",
        "@testing-library/react-native": "14.1.0",
        "@types/jest": "30.0.0",
        "@types/react": "19.3.0",
        "eslint": "^9.39.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.13.0",
        "jest": "30.5.2",
        "jest-expo": "58.0.13",
        "react-dom": "19.3.0",
        "test-renderer": "1.3.0",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.72.1"
