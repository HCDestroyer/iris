# Panel web de Iris (apps/web). cp .env.example .env.local
# Puerto de `next dev` / `next start` (en pruebas, el de I3: 3503).
PORT=3000
# URL con que el servidor de Next alcanza la API (proxy /api/* → IRIS_API_URL/api/*).
# Se lee en tiempo de ejecución: la misma imagen sirve para dev, lab y producción.
IRIS_API_URL=http://localhost:8080
# Origen público del panel (lo usa la API para enlaces; aquí solo se documenta).
IRIS_BASE_URL=http://localhost:3000
