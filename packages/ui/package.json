{
    "name": "@iris/ui",
    "version": "0.0.0",
    "private": true,
    "description": "Componentes compartidos de Iris sobre HeroUI v3 (React Aria) con la identidad Horus: tokens, tema, logo y estados",
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./firma": {
            "types": "./src/componentes/firma.ts",
            "default": "./src/componentes/firma.ts"
        },
        "./estilos.css": "./src/estilos/estilos.css",
        "./logo-mark.svg": "./src/marca/logo-mark.svg"
    },
    "scripts": {
        "lint": "eslint .",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest run"
    },
    "dependencies": {
        "@heroui/react": "3.2.6",
        "@heroui/styles": "3.2.6",
        "@internationalized/date": "~3.12.4",
        "@react-aria/ssr": "~3.10.1",
        "@react-aria/utils": "~3.34.1",
        "@zxing/browser": "^0.2.1",
        "@zxing/library": "^0.23.0",
        "clsx": "^2.1.1",
        "lucide-react": "^1.62.0",
        "react-aria": "~3.52.1",
        "react-aria-components": "~1.21.1",
        "tailwind-merge": "^3.7.0"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/node": "^22.20.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "eslint": "^9.39.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.13.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.72.1",
        "vitest": "^5.0.5"
    }
}
